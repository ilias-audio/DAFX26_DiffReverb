      },
      {
        "id": "FDN_FixedDelayTrainMix_ER_PEQ10",
        "name": "FDN (fixed delay, train mix)",
        "group": "proposed",
        "desc": "Recommended setting. Delays fixed at co-prime integers, and the mixing matrix, filters, and early-reflection taps trained. The most robust configuration in practice.",
        "recommended": true
      },
      {
        "id": "NoiseShaper_24",
        "name": "NoiseShaper",

      },
      {
        "id": "FDN_DiffER_PEQ10",
        "name": "Proposed (all-diff)",
        "group": "proposed",
        "desc": "The proposed model. Trainable delays, orthogonal mixing matrix, PEQ attenuation, and early-reflection taps, all optimized jointly.",

      },
      {
        "id": "Mezza_16k",
        "name": "DFDN",
        "group": "baseline",
        "desc": "Differentiable FDN baseline with trainable FIR attenuation and 6 delay lines at 16 kHz.",
        "recommended": false
      },
      {
        "id": "RIR2FDN",
        "name": "RIR2FDN",
        "group": "baseline",
        "desc": "Analysis and synthesis pipeline of Dal Santo et al., a 6-line scattering FDN with two-stage attenuation.",
        "recommended": false
      }
    ],
